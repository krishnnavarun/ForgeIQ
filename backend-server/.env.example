NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
SESSION_TTL_DAYS=7

# Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/auth/google/callback

# GitHub OAuth App (https://github.com/settings/developers) — leave blank to keep
# the GitHub integration disabled; the UI reports it as "not configured" until set.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/v1/organizations/integrations/github/callback
# GitHub webhook secret configured on the repo/org webhook. Required to accept webhook events.
GITHUB_WEBHOOK_SECRET=

# 32+ character key used to encrypt stored OAuth access tokens at rest. Generate
# a real random value for any non-local environment (e.g. `openssl rand -hex 32`).
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters

# Anthropic API key for AI-generated engineering summaries. Leave blank to keep
# AI insights disabled; the UI reports it as "not configured" until set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"
